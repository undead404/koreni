  "engines": {
    "node": "22"
  },
  "license": "MIT",
  "name": "koreni-monorepo",
  "packageManager": "yarn@4.0.0",
  "private": true,
  "scripts": {
    "artifacts:clean": "./scripts/clean-repo/clean-repo.sh",
    "build": "next build",
    "data:modernize-russian": "tsx src/modernize-russian/index.ts",
    "data:validate": "tsx src/validate-data-contribution/index.ts",
    "dev": "next dev --turbopack --port 3001",
    "dev:all": "concurrently --names 'frontend,server' --prefix '[{name}]' --colors --kill-others-on-fail 'yarn dev' 'yarn dev:server'",
    "dev:server": "cd src/server && yarn dev",
    "docker:typesense:remove": "docker rm typesense-server",
    "docker:typesense:start": "tsx src/dockerize-typesense/index.ts",
    "docker:typesense:stop": "docker stop typesense-server",
    "lint": "eslint .",
    "lint:css": "stylelint \"**/*.css\"",
    "karma:push": "tsx src/scripts/karma-push.ts",
    "prepare": "husky",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc --noEmit --project src/server/tsconfig.json",
    "typesense:populate": "tsx src/populate-typesense/index.ts"
  },
  "type": "module",
  "version": "0.1.0",
  "workspaces": [
    "src/server",
    "src/shared",
    "src/daily-report"
  ]
}
